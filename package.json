{
  "name": "@codemao-pickcat/browser-game-sandbox",
  "version": "0.3.3",
  "description": "Bare browser sandbox host bridge for untrusted web games",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": [
    "./dist/game-preload.js",
    "./dist/game.preload.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./game.preload.js": "./dist/game.preload.js",
    "./package.runtime.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/package.runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "prepare": "npm run build",
    "prebuild": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json && npm run build:browser",
    "build:browser": "node scripts/build-browser.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:types": "tsc -p tsconfig.tests.json --noEmit",
    "test:vue": "npm run build && npm --prefix test/vue-compat install --no-package-lock --ignore-scripts && npm --prefix test/vue-compat run build",
    "test:browser": "npm run build && playwright test -c playwright.config.mjs",
    "test:all": "npm test && npm run check:types && npm run test:vue && npm run test:browser && npm run check:package",
    "check:package": "npm pack --dry-run --json | node scripts/verify-package.mjs",
    "check": "npm run build && npm run check:types && npm test && npm run check:package"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/css-tree": "^3.2.0",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "css-tree": "^3.2.1",
    "parse5": "^8.1.1",
    "zod": "^4.6.7"
  }
}
